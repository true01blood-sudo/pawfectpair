# ============================================================
# PawfectPair — Variabile de mediu mobile (NU commit-ui acest fișier)
# Copiază în .env și completează cu valorile proiectului tău Supabase
# ============================================================

# URL proiect Supabase (dashboard → Project Settings → API → Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Cheia anon (公开 prin design — securitatea vine din RLS, nu din ascunderea cheii)
# Dashboard → Project Settings → API → Project API keys → anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Opțional) Supabase — regiunea proiectului, pentru diagnosticare
EXPO_PUBLIC_SUPABASE_REGION=eu-central-1

# (Opțional) App Check / PostgREST — lăsat implicit
# EXPO_PUBLIC_SUPABASE_AUTH_CALLBACK_URL=pawfectpair://auth/callback
