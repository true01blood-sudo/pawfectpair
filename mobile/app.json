{
  "expo": {
    "name": "Pet Care Services",
    "slug": "pawfectpair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawfectpair",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7ED"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pawfectpair.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Pet Care Services folosește camera pentru a fotografia animalul tău de companie.",
        "NSPhotoLibraryUsageDescription": "Pet Care Services accesează galeria pentru a selecta o poză a animalului tău.",
        "NSUserNotificationsUsageDescription": "Pet Care Services te anunță despre scadențe medicale și match-uri noi."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      }
    },
    "android": {
      "package": "app.pawfectpair.mobile",
      "versionCode": 10,
      "targetSdkVersion": 36,
      "compileSdkVersion": 36,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAB-vdzeqLYPS4_nIdRuCmixLP0JmEdvlw"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF7ED"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pet Care Services accesează galeria pentru a selecta o poză a animalului tău."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "872815b8-4c75-4e15-b141-28b026fb5b1c"
      },
      "router": {
        "origin": false
      }
    },
    "updates": {
      "url": "https://u.expo.dev/",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "truebloods-team"
  }
}
